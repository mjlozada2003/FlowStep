# Configuración de Base de Datos
# NOTA: docker-compose.yml mapea el puerto 5433 del host al 5432 del contenedor (ports: 5433:5432).
# Usa DB_PORT=5433 al conectar desde tu máquina local al contenedor Docker.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=flowstep_db

# Base de datos en la nube (Supabase u otro PostgreSQL). Si DATABASE_URL tiene valor,
# reemplaza a DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD y DB_NAME.
# Reemplaza [YOUR-PASSWORD] con la contraseña real de la base de datos.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Define DB_SSL=true para habilitar SSL al usar una base de datos en la nube.
# DB_SSL=true

# Seguridad JWT: configura un secreto aleatorio y seguro antes de iniciar el backend.
JWT_SECRET=replace_with_a_long_random_secret

# Inteligencia Artificial (Gemini): clave de API de Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# Zona Horaria Oficial
APP_TIMEZONE=America/La_Paz
