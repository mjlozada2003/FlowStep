# Configuración de Base de Datos
# NOTA: docker-compose.yml mapea el puerto 5433 del host al 5432 del contenedor (ports: 5433:5432).
# Usa DB_PORT=5433 al conectar desde tu máquina local al contenedor Docker.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=flowstep_db

# Base de datos en la nube (Supabase). Si DATABASE_URL tiene valor, reemplaza a DB_HOST..DB_NAME.
# Supabase > Connect > "Session pooler" (puerto 5432). Reemplaza [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DB_SSL=true

# Seguridad JWT
JWT_SECRET=tu_jwt_secret_aqui

# Inteligencia Artificial (Gemini)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Zona Horaria Oficial
APP_TIMEZONE=America/La_Paz
